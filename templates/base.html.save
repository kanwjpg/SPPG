<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#b7ff00">
<title>{% block title %}SPPG Manager{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="{{ url_for('static', filename='style.css') }}" rel="stylesheet">
</head>
<body class="{% if not session.user_id %}auth-page{% endif %}">
{% if session.user_id %}
<div class="app-shell">
  <aside class="app-sidebar" id="appSidebar">
    <div class="brand">
      <a href="{{ url_for('dashboard') }}" class="brand-link">
        <span class="brand-mark"><i class="bi bi-egg-fried"></i></span>
        <span>
          <strong>SPPG</strong>
          <small>Operations</small>
        </span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Tutup menu"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="sidebar-label">Workspace</div>
    <nav class="side-nav">
      <a class="side-link {% if request.endpoint == 'dashboard' %}active{% endif %}" href="{{ url_for('dashboard') }}">
        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
      </a>
      <a class="side-link {% if request.endpoint in ['menu_list','menu_tambah','menu_detail'] %}active{% endif %}" href="{{ url_for('menu_list') }}">
        <i class="bi bi-egg-fried"></i><span>Menu &amp; Gizi</span>
      </a>
      <a class="side-link {% if request.endpoint in ['stok_list','stok_tambah'] %}active{% endif %}" href="{{ url_for('stok_list') }}">
        <i class="bi bi-box-seam"></i><span>Stok Bahan</span>
      </a>
      <a class="side-link {% if request.endpoint in ['checklist_list','checklist_form'] %}active{% endif %}" href="{{ url_for('checklist_list') }}">
        <i class="bi bi-shield-check"></i><span>Keamanan Pangan</span>
        {% if request.endpoint == 'dashboard' and menu_belum_checklist|default(0) > 0 %}
        <span class="nav-dot"></span>
        {% endif %}
      </a>
      <a class="side-link {% if request.endpoint == 'petugas_list' %}active{% endif %}" href="{{ url_for('petugas_list') }}">
        <i class="bi bi-person-badge"></i><span>Petugas</span>
      </a>
      <a class="side-link {% if request.endpoint in ['sekolah_list','sekolah_tambah'] %}active{% endif %}" href="{{ url_for('sekolah_list') }}">
        <i class="bi bi-building"></i><span>Sekolah</span>
      </a>
    </nav>

    <div class="sidebar-spacer"></div>
    <div class="sidebar-help">
      <div class="help-icon"><i class="bi bi-lightning-charge-fill"></i></div>
      <div>
        <strong>Operasional rapi</strong>
        <p>Kelola menu, stok, dan keamanan dalam satu tempat.</p>
      </div>
    </div>
    <a href="{{ url_for('logout') }}" class="side-link logout-link"><i class="bi bi-box-arrow-right"></i><span>Keluar</span></a>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="app-main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle d-lg-none" id="sidebarOpen" aria-label="Buka menu"><i class="bi bi-list"></i></button>
        <div class="breadcrumb-wrap">
          <span class="eyebrow">SPPG Manager</span>
          <span class="current-page">{% block page_name %}Workspace{% endblock %}</span>
        </div>
      </div>
      <div class="topbar-right">
        <a href="{{ url_for('checklist_list') }}" class="icon-btn" title="Keamanan pangan">
          <i class="bi bi-bell"></i>
          {% if menu_belum_checklist|default(0) > 0 %}<span class="notification-dot"></span>{% endif %}
        </a>
        <div class="user-chip">
          <span class="avatar">{{ (current_user_nama or 'A')[:1]|upper }}</span>
          <span class="user-name">{{ current_user_nama }}</span>
          <i class="bi bi-chevron-down"></i>
        </div>
      </div>
    </header>

    <div class="page-content">
      {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
          <div class="flash-stack">
          {% for category, message in messages %}
            <div class="flash-message {{ 'error' if category == 'error' else 'success' }}">
              <i class="bi {{ 'bi-exclamation-triangle-fill' if category == 'error' else 'bi-check-circle-fill' }}"></i>
              <span>{{ message }}</span>
              <button type="button" class="flash-close" aria-label="Tutup"><i class="bi bi-x"></i></button>
            </div>
          {% endfor %}
          </div>
        {% endif %}
      {% endwith %}
      
{% block content %}{% endblock %}
    </div>
  </main>
</div>
{% else %}
  <main class="auth-main">
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        <div class="auth-flashes">
        {% for category, message in messages %}
          <div class="flash-message {{ 'error' if category == 'error' else 'success' }}">
            <i class="bi {{ 'bi-exclamation-triangle-fill' if category == 'error' else 'bi-check-circle-fill' }}"></i>
            <span>{{ message }}</span>
          </div>
        {% endfor %}
        </div>
      {% endif %}
    {% endwith %}
    {% block content %}{% endblock %}
  </main>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ url_for('static', filename='app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
